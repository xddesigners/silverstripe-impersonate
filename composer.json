{
    "name": "xddesigners/silverstripe-impersonate",
    "description": "Lets Administrators or a designated group temporarily log in as another Member, with a safe, auditable way back to their own account.",
    "type": "silverstripe-vendormodule",
    "keywords": [
        "silverstripe",
        "impersonate",
        "login-as",
        "support",
        "security"
    ],
    "license": "BSD-3-Clause",
    "require": {
        "php": "^8.1",
        "silverstripe/framework": "^5.0 || ^6.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "squizlabs/php_codesniffer": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "XD\\Impersonate\\": "src/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
